{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servsync.app/schemas/codex-marketing-package-v1.json",
  "title": "ServSync Codex-assisted Marketing package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparation_request_id",
    "recipe_key",
    "truth_pack_version",
    "brief_summary",
    "items"
  ],
  "properties": {
    "preparation_request_id": { "type": "string", "format": "uuid" },
    "recipe_key": {
      "type": "string",
      "enum": ["contractor_acquisition", "homeowner_awareness", "feature_promotion"]
    },
    "truth_pack_version": { "const": "servsync-marketing-truth-v1" },
    "brief_summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "content_type",
          "body",
          "channel_category",
          "intended_audience",
          "content_role"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "content_type": {
            "type": "string",
            "enum": ["social_post", "email", "website_copy", "other"]
          },
          "body": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "channel_category": {
            "type": "string",
            "enum": ["social", "email", "website", "other"]
          },
          "intended_audience": {
            "type": "string",
            "enum": ["small_contractors", "hvac_contractors", "plumbers", "electricians", "homeowners"]
          },
          "content_role": {
            "type": "string",
            "enum": [
              "facebook_instagram_post",
              "linkedin_post",
              "educational_post",
              "feature_highlight",
              "short_video_concept",
              "problem_solution_post",
              "local_contractor_connection",
              "feature_announcement",
              "contractor_benefit",
              "homeowner_benefit"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servsync.app/schemas/codex-approved-direction-package.v1.schema.json",
  "title": "ServSync Codex approved-Direction content package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparation_request_id",
    "source_plan_id",
    "source_plan_revision",
    "truth_pack_version",
    "preparation_contract_key",
    "items"
  ],
  "properties": {
    "preparation_request_id": { "type": "string", "format": "uuid" },
    "source_plan_id": { "type": "string", "format": "uuid" },
    "source_plan_revision": { "type": "integer", "minimum": 1 },
    "truth_pack_version": { "const": "servsync-marketing-truth-v3" },
    "preparation_contract_key": { "const": "approved_direction_plan_v1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction_id",
          "direction_revision",
          "title",
          "content_type",
          "body",
          "channel_category",
          "intended_audience",
          "content_role"
        ],
        "properties": {
          "direction_id": { "type": "string", "format": "uuid" },
          "direction_revision": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "content_type": { "enum": ["social_post", "email", "website_copy", "other"] },
          "body": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "channel_category": { "enum": ["social", "email", "website", "other"] },
          "intended_audience": {
            "enum": [
              "small_contractors",
              "hvac_contractors",
              "plumbers",
              "electricians",
              "carpentry_contractors",
              "lawn_landscaping_contractors",
              "pressure_washing_contractors",
              "handyman_contractors",
              "homeowners"
            ]
          },
          "content_role": {
            "enum": [
              "facebook_instagram_post",
              "linkedin_post",
              "educational_post",
              "feature_highlight",
              "short_video_concept",
              "problem_solution_post",
              "local_contractor_connection",
              "feature_announcement",
              "contractor_benefit",
              "homeowner_benefit"
            ]
          }
        }
      }
    }
  }
}

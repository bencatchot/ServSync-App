{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servsync.app/schemas/codex-marketing-directions-v1.json",
  "title": "ServSync Codex-assisted Marketing Directions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparation_request_id",
    "source_plan_id",
    "source_plan_revision",
    "truth_pack_version",
    "preparation_source",
    "direction_mode",
    "owner_input",
    "directions"
  ],
  "properties": {
    "preparation_request_id": { "type": "string", "format": "uuid" },
    "source_plan_id": { "type": "string", "format": "uuid" },
    "source_plan_revision": { "type": "integer", "minimum": 1 },
    "truth_pack_version": { "const": "servsync-marketing-truth-v3" },
    "preparation_source": { "const": "codex_assisted" },
    "direction_mode": { "type": "string", "enum": ["owner_led", "recommended"] },
    "owner_input": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_item_index",
          "audience_key",
          "objective",
          "statement",
          "central_message",
          "supporting_points",
          "cautions",
          "corrected_assumptions",
          "recommendation_rationale",
          "truth_capability_keys"
        ],
        "properties": {
          "plan_item_index": { "type": "integer", "minimum": 1, "maximum": 7 },
          "audience_key": {
            "type": "string",
            "enum": [
              "small_contractors",
              "hvac_contractors",
              "plumbers",
              "electricians",
              "carpentry_contractors",
              "lawn_landscaping_contractors",
              "pressure_washing_contractors",
              "handyman_contractors",
              "homeowners"
            ]
          },
          "objective": { "type": "string", "minLength": 20, "maxLength": 240 },
          "statement": { "type": "string", "minLength": 80, "maxLength": 500 },
          "central_message": { "type": "string", "minLength": 20, "maxLength": 500 },
          "supporting_points": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "cautions": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "corrected_assumptions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "correction"],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "competitor_account_requirement",
                    "competitor_app_download_requirement",
                    "competitor_subscription_requirement",
                    "competitor_inferiority"
                  ]
                },
                "correction": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "recommendation_rationale": { "type": ["string", "null"], "minLength": 20, "maxLength": 500 },
          "truth_capability_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      }
    }
  }
}

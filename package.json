{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "node scripts/validation/check-eslint-warning-budget.mjs",
    "check:app-size": "node scripts/validation/check-app-monolith-budget.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "preview": "vite preview",
    "demo:seed": "node scripts/demo/seed-demo-scenario.mjs seed water_heater_core_loop",
    "demo:reset": "node scripts/demo/seed-demo-scenario.mjs reset water_heater_core_loop",
    "demo:verify": "node scripts/demo/seed-demo-scenario.mjs verify water_heater_core_loop",
    "demo:checkpoints": "node scripts/demo/seed-demo-scenario.mjs checkpoints",
    "demo:record": "node scripts/demo/record-demo.mjs",
    "help:record": "node scripts/help/run-help-studio-recording.mjs",
    "demo:approve-marketing": "node scripts/demo/approve-marketing-recording.mjs",
    "qa": "npm run typecheck && npm run build",
    "qa:e2e": "npm run typecheck && npm run build && npm run test:e2e",
    "qa:e2e:geocoding": "playwright test tests/e2e/discover-geocoding-radius.spec.ts",
    "qa:e2e:mobile": "playwright test tests/e2e/mobile-smoke.spec.ts",
    "qa:e2e:mutating": "playwright test tests/e2e/contractor-create-customer.spec.ts tests/e2e/contractor-create-job.spec.ts tests/e2e/contractor-create-estimate.spec.ts tests/e2e/contractor-create-invoice.spec.ts tests/e2e/contractor-finalize-report.spec.ts tests/e2e/discover-geocoding-radius.spec.ts",
    "qa:e2e:contractor-workflow": "playwright test tests/e2e/full-core-loop.spec.ts tests/e2e/contractor-local-customer-lifecycle.spec.ts",
    "qa:e2e:production-auth-readonly-smoke": "node tests/helpers/check-production-smoke-env.mjs --auth-readonly --strict && playwright test tests/e2e/production-auth-readonly-smoke.spec.ts --project=chromium",
    "qa:e2e:production-public-smoke": "playwright test tests/e2e/production-public-smoke.spec.ts --project=chromium",
    "qa:e2e:readonly": "playwright test tests/e2e/contractor-smoke.spec.ts tests/e2e/homeowner-smoke.spec.ts",
    "backend:parity:check": "node scripts/backend-parity/check.mjs",
    "backend:parity:test": "node --test tests/backend-parity/*.test.mjs",
    "backend:rollout:status": "node scripts/backend-parity/rollout-status.mjs",
    "ops:recovery:validate": "node scripts/recovery/validate-restored-project.mjs",
    "ops:storage-backup:run": "tsx scripts/storage-backup/run-storage-backup.ts",
    "ops:storage-backup:health": "tsx scripts/storage-backup/check-storage-backup-health.ts",
    "ops:storage-backup:observe-scheduled": "tsx scripts/storage-backup/observe-scheduled-storage-backup.ts",
    "ops:storage-backup:restore": "tsx scripts/recovery/restore-storage-from-r2.ts",
    "ops:role-smoke:api": "tsx scripts/operational-smoke/run-role-fixture-health.ts",
    "test:role-smoke-contract": "node --test tests/operational-smoke/*.test.ts",
    "test:core-state-reliability": "node --import tsx --test tests/reliability/*.test.ts",
    "test:core-authoring-idempotency": "node --import tsx --test tests/reliability/core-authoring-idempotency.test.ts",
    "test:accepted-connection-context": "bash scripts/validation/validate-accepted-connection-request-context.sh && TEST_APP_URL=http://localhost:4173 playwright test tests/e2e/accepted-connection-request-context.spec.ts --project=chromium",
    "qa:e2e:role-smoke": "playwright test tests/e2e/recurring-authenticated-role-smoke.spec.ts --project=chromium",
    "qa:e2e:role-smoke:demo": "playwright test tests/e2e/recurring-demo-readonly-smoke.spec.ts --project=chromium",
    "test:recovery-validator": "node --test tests/recovery/*.test.mjs",
    "test:storage-backup": "node --test tests/storage-backup/*.test.ts",
    "test:demo-recorder": "node --test tests/demo-recorder/*.test.mjs",
    "test:trade-pack-domain-contracts": "bash scripts/validation/validate-trade-pack-domain-contracts.sh",
    "test:property-asset-bridge": "bash scripts/validation/validate-property-asset-bridge.sh",
    "test:durable-trade-sections": "bash scripts/validation/validate-durable-trade-sections.sh",
    "qa:production-smoke:check": "node tests/helpers/check-production-smoke-env.mjs",
    "load:public": "k6 run tests/load/public-anonymous.js",
    "load:sandbox:auth-read": "k6 run tests/load/sandbox-auth-read.js",
    "load:check": "node tests/load/helpers/check-load-env.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:controlled-ops": "node --test tests/controlled-ops/*.test.mjs",
    "test:controlled-ops:browser": "node --test tests/controlled-ops/browser-*.test.mjs",
    "test:controlled-ops:browser:pilot": "node tests/controlled-ops/browser-pilot/run-pilot.mjs",
    "test:draft-optional-customer-migrations": "scripts/validation/validate-draft-optional-customer-migrations.sh",
    "test:public-signup-role-hardening": "scripts/validation/validate-public-signup-role-hardening.sh",
    "test:accepted-estimate-deposit-workflow": "scripts/validation/validate-accepted-estimate-deposit-workflow.sh",
    "test:draft-invoice-mark-paid": "bash scripts/validation/validate-draft-invoice-mark-paid.sh && playwright test tests/e2e/accepted-estimate-deposit-workflow.spec.ts tests/e2e/invoice-payment-presentation.spec.ts tests/e2e/estimate-invoice-pdf-actions.spec.ts tests/e2e/invoice-pdf-preview-download-parity.spec.ts --project=chromium",
    "test:admin-office-estimate-authority": "bash scripts/validation/validate-admin-office-estimate-authority.sh",
    "test:stripe-connect-online-payments": "scripts/validation/validate-stripe-connect-online-payments-foundation.sh",
    "test:codex-marketing-drafts": "bash scripts/validation/validate-codex-assisted-marketing-drafts.sh && node --test tests/marketing/codex-marketing-package-contract.test.mjs",
    "test:business-marketing-planning": "bash scripts/validation/validate-business-marketing-profile-plan.sh",
    "test:marketing-planner-quality-v2": "bash scripts/validation/validate-marketing-planner-quality-v2.sh",
    "test:marketing-planner-coherence-v3": "bash scripts/validation/validate-marketing-planner-coherence-relevance-v3.sh",
    "test:marketing-directions": "bash scripts/validation/validate-accepted-plan-marketing-directions.sh && node --test tests/marketing/marketing-direction-preparation-contract.test.mjs",
    "test:marketing-publishing": "bash scripts/validation/validate-provider-neutral-marketing-publishing.sh && node --import tsx --test tests/marketing/marketing-publishing-worker.test.ts",
    "test:marketing-media-assets": "bash scripts/validation/validate-marketing-media-assets.sh",
    "test:narrated-marketing-media": "bash scripts/validation/validate-narrated-marketing-media-publication.sh",
    "test:facebook-marketing-connection": "bash scripts/validation/validate-facebook-marketing-connection.sh && node --import tsx --test tests/marketing/facebook-marketing-connection.test.ts tests/marketing/marketing-publishing-worker.test.ts",
    "test:facebook-managed-video-publishing": "bash scripts/validation/validate-facebook-managed-video-publishing.sh && node --import tsx --test tests/marketing/facebook-marketing-connection.test.ts tests/marketing/marketing-publishing-worker.test.ts",
    "test:shared-marketing-workspace-security": "bash scripts/validation/validate-shared-marketing-workspace-security-foundation.sh",
    "test:marketing-media-cost-lifecycle": "bash scripts/validation/validate-marketing-media-cost-lifecycle.sh && node --import tsx --test tests/marketing/marketing-media-cost-lifecycle.test.ts",
    "test:marketing-publishing-queue": "bash scripts/validation/validate-marketing-publishing-queue-authorization.sh && node --import tsx --test tests/marketing/marketing-publishing-queue.test.ts tests/marketing/facebook-marketing-connection.test.ts tests/marketing/marketing-publishing-worker.test.ts",
    "test:owner-marketing-publishing-flow": "bash scripts/validation/validate-owner-marketing-publishing-flow.sh && node --import tsx --test tests/marketing/marketing-publishing-queue.test.ts tests/marketing/facebook-marketing-connection.test.ts tests/marketing/marketing-publishing-worker.test.ts",
    "test:contractor-marketing-content-creation": "bash scripts/validation/validate-contractor-marketing-content-creation.sh && node --import tsx --test tests/marketing/contractor-marketing-content-creation.test.ts",
    "test:help-studio": "bash scripts/validation/validate-help-studio-foundation.sh && node --import tsx --test tests/help/help-studio.test.ts tests/help/help-studio-recorder.test.mjs && playwright test tests/e2e/help-studio-contextual-playback.spec.ts --project=chromium",
    "test:approved-direction-content": "bash scripts/validation/validate-approved-direction-content-preparation.sh && node --test tests/marketing/approved-direction-package-contract.test.mjs",
    "test:price-book-import-rollback": "bash scripts/validation/validate-price-book-import-rollback.sh",
    "test:price-book-cost-margin": "bash scripts/validation/validate-price-book-cost-margin.sh",
    "marketing:ingest-codex-package": "node scripts/marketing/ingest-codex-marketing-package.mjs",
    "marketing:validate-approved-direction-package": "node scripts/marketing/approved-direction-package-contract.mjs",
    "marketing:ingest-approved-direction-package": "node scripts/marketing/ingest-approved-direction-marketing-package.mjs",
    "marketing:prepare-codex-directions": "node scripts/marketing/prepare-codex-marketing-directions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "1.2.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "24.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "write-excel-file": "^4.1.1"
  }
}

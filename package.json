{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "demo:seed": "node scripts/demo/seed-demo-scenario.mjs seed water_heater_core_loop",
    "demo:reset": "node scripts/demo/seed-demo-scenario.mjs reset water_heater_core_loop",
    "demo:verify": "node scripts/demo/seed-demo-scenario.mjs verify water_heater_core_loop",
    "demo:checkpoints": "node scripts/demo/seed-demo-scenario.mjs checkpoints",
    "qa": "npm run typecheck && npm run build",
    "qa:e2e": "npm run typecheck && npm run build && npm run test:e2e",
    "qa:e2e:geocoding": "playwright test tests/e2e/discover-geocoding-radius.spec.ts",
    "qa:e2e:mobile": "playwright test tests/e2e/mobile-smoke.spec.ts",
    "qa:e2e:mutating": "playwright test tests/e2e/contractor-create-customer.spec.ts tests/e2e/contractor-create-job.spec.ts tests/e2e/contractor-create-estimate.spec.ts tests/e2e/contractor-create-invoice.spec.ts tests/e2e/contractor-finalize-report.spec.ts tests/e2e/discover-geocoding-radius.spec.ts",
    "qa:e2e:contractor-workflow": "playwright test tests/e2e/full-core-loop.spec.ts tests/e2e/contractor-local-customer-lifecycle.spec.ts",
    "qa:e2e:production-auth-readonly-smoke": "node tests/helpers/check-production-smoke-env.mjs --auth-readonly --strict && playwright test tests/e2e/production-auth-readonly-smoke.spec.ts --project=chromium",
    "qa:e2e:production-public-smoke": "playwright test tests/e2e/production-public-smoke.spec.ts --project=chromium",
    "qa:e2e:readonly": "playwright test tests/e2e/contractor-smoke.spec.ts tests/e2e/homeowner-smoke.spec.ts",
    "backend:parity:check": "node scripts/backend-parity/check.mjs",
    "backend:parity:test": "node --test tests/backend-parity/*.test.mjs",
    "backend:rollout:status": "node scripts/backend-parity/rollout-status.mjs",
    "test:trade-pack-domain-contracts": "bash scripts/validation/validate-trade-pack-domain-contracts.sh",
    "test:property-asset-bridge": "bash scripts/validation/validate-property-asset-bridge.sh",
    "test:durable-trade-sections": "bash scripts/validation/validate-durable-trade-sections.sh",
    "qa:production-smoke:check": "node tests/helpers/check-production-smoke-env.mjs",
    "load:public": "k6 run tests/load/public-anonymous.js",
    "load:sandbox:auth-read": "k6 run tests/load/sandbox-auth-read.js",
    "load:check": "node tests/load/helpers/check-load-env.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:controlled-ops": "node --test tests/controlled-ops/*.test.mjs",
    "test:controlled-ops:browser": "node --test tests/controlled-ops/browser-*.test.mjs",
    "test:controlled-ops:browser:pilot": "node tests/controlled-ops/browser-pilot/run-pilot.mjs",
    "test:draft-optional-customer-migrations": "scripts/validation/validate-draft-optional-customer-migrations.sh",
    "test:public-signup-role-hardening": "scripts/validation/validate-public-signup-role-hardening.sh",
    "test:accepted-estimate-deposit-workflow": "scripts/validation/validate-accepted-estimate-deposit-workflow.sh",
    "test:draft-invoice-mark-paid": "bash scripts/validation/validate-draft-invoice-mark-paid.sh && playwright test tests/e2e/accepted-estimate-deposit-workflow.spec.ts tests/e2e/invoice-payment-presentation.spec.ts tests/e2e/estimate-invoice-pdf-actions.spec.ts tests/e2e/invoice-pdf-preview-download-parity.spec.ts --project=chromium",
    "test:stripe-connect-online-payments": "scripts/validation/validate-stripe-connect-online-payments-foundation.sh",
    "test:codex-marketing-drafts": "bash scripts/validation/validate-codex-assisted-marketing-drafts.sh && node --test tests/marketing/codex-marketing-package-contract.test.mjs",
    "test:business-marketing-planning": "bash scripts/validation/validate-business-marketing-profile-plan.sh",
    "test:marketing-planner-quality-v2": "bash scripts/validation/validate-marketing-planner-quality-v2.sh",
    "test:marketing-planner-coherence-v3": "bash scripts/validation/validate-marketing-planner-coherence-relevance-v3.sh",
    "test:marketing-directions": "bash scripts/validation/validate-accepted-plan-marketing-directions.sh && node --test tests/marketing/marketing-direction-preparation-contract.test.mjs",
    "test:approved-direction-content": "bash scripts/validation/validate-approved-direction-content-preparation.sh && node --test tests/marketing/approved-direction-package-contract.test.mjs",
    "test:price-book-import-rollback": "bash scripts/validation/validate-price-book-import-rollback.sh",
    "marketing:ingest-codex-package": "node scripts/marketing/ingest-codex-marketing-package.mjs",
    "marketing:validate-approved-direction-package": "node scripts/marketing/approved-direction-package-contract.mjs",
    "marketing:ingest-approved-direction-package": "node scripts/marketing/ingest-approved-direction-marketing-package.mjs",
    "marketing:prepare-codex-directions": "node scripts/marketing/prepare-codex-marketing-directions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "1.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "24.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.0.16"
  }
}
